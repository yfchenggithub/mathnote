  "math": {
    "core_formula": "d = \\frac{\\bigl| \\overrightarrow{AB} \\cdot (\\vec{u} \\times \\vec{v}) \\bigr|}{|\\vec{u} \\times \\vec{v}|}",
    "related_formulas": [
      "d = \\frac{|\\overrightarrow{AB} \\cdot \\vec{n}|}{|\\vec{n}|},\\ \\vec{n} = \\vec{u} \\times \\vec{v}"
    ],
    "variables": [
      "\\vec{u}",
      "\\vec{v}",
