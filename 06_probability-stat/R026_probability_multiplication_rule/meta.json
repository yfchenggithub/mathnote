  "math": {
    "core_formula": "P(AB)=P(A)P(B|A)\\quad (P(A)>0)",
    "related_formulas": [
      "P(A_1A_2\\cdots A_n)=P(A_1)P(A_2|A_1)P(A_3|A_1A_2)\\cdots P(A_n|A_1\\cdots A_{n-1})"
    ],
    "variables": "事件 $A$, $B$, $A_i$, 概率 $P$",
    "conditions": "$P(A)>0$；对多个事件，$P(A_1A_2\\cdots A_{n-1})>0$。",
    "conclusions": "条件概率公式 $P(B|A)=\\dfrac{P(AB)}{P(A)}$（当 $P(A)>0$）。"
  },
  "content": {
    "statement": "若事件 $A,B$ 满足 $P(A)>0$，则 $P(AB)=P(A)P(B|A)$。更一般地，对 $n$ 个事件 $A_1,\\dots,A_n$，若 $P(A_1\\cdots A_{n-1})>0$，有 $P(A_1A_2\\cdots A_n)=P(A_1)P(A_2|A_1)P(A_3|A_1A_2)\\cdots P(A_n|A_1\\cdots A_{n-1})$。",
    "derivation": [
      "由条件概率定义 $P(B|A)=P(AB)/P(A)$（$P(A)>0$）。",
      "两边同乘 $P(A)$ 得 $P(AB)=P(A)P(B|A)$。",
      "对多事件，逐次应用两事件乘法公式即可推广。"
    ],
    "intuition": "事件A发生后再考虑B发生的概率，乘积就是两者同时发生的概率，类似于分步计数原理。",
    "common_tricks": [
      "注意条件概率的分母不能为零，即 $P(A)>0$。",
      "用于不放回抽样时，按抽取顺序逐步计算条件概率。",
      "多事件时严格按照事件顺序依次相乘，不可颠倒。",
      "可与全概率公式结合，用于复杂事件的概率求解。"
    ]
  },
