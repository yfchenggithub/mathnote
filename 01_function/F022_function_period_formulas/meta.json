    "core_formula": "f(x+a)=f(x) \\Rightarrow T=|a|",
    "related_formulas": [
      "f(x+a)=-f(x) \\Rightarrow T=2|a|",
      "f(x+a)=\\pm\\frac{1}{f(x)} \\; (f(x)\\neq 0) \\Rightarrow T=2|a|",
