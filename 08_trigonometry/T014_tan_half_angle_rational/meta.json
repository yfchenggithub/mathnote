  "math": {
    "core_formula": "\\sin x = \\frac{2t}{1+t^2}, \\quad \\cos x = \\frac{1-t^2}{1+t^2} \\quad (t=\\tan\\frac{x}{2}, x\\neq\\pi+2k\\pi, k\\in\\mathbb{Z})",
    "related_formulas": [
      "\\tan x = \\frac{2t}{1-t^2} \\quad (x\\neq\\frac{\\pi}{2}+k\\pi)"
    ],
    "variables": {
      "t": "半角正切值",
      "x": "原角（弧度）",
      "k": "整数"
    },
    "conditions": [
      "定义域：$x\\neq \\pi+2k\\pi\\ (k\\in\\mathbb{Z})$，保证 $t=\\tan\\frac{x}{2}$ 有意义。",
      "对于 $\\tan x$ 公式，还需 $x\\neq \\frac{\\pi}{2}+k\\pi$，确保分母 $1-t^2 \\neq 0$。"
    ],
    "conclusions": [
      "$\\sin x$ 和 $\\cos x$ 均可表示为 $t$ 的有理函数。",
      "当附加条件满足时，$\\tan x$ 也可用 $t$ 表示。"
    ]
  },
  "content": {
    "statement": "设 $t=\\tan\\frac{x}{2}$（$x\\neq\\pi+2k\\pi,\\ k\\in\\mathbb{Z}$），则 $\\sin x=\\frac{2t}{1+t^2}$，$\\cos x=\\frac{1-t^2}{1+t^2}$；若还有 $x\\neq\\frac{\\pi}{2}+k\\pi$，则 $\\tan x=\\frac{2t}{1-t^2}$。",
    "derivation": [
      "利用二倍角公式 $\\sin x=2\\sin\\frac{x}{2}\\cos\\frac{x}{2}$。",
      "分子分母同除以 $\\cos^2\\frac{x}{2}$，得 $\\frac{2\\tan\\frac{x}{2}}{1+\\tan^2\\frac{x}{2}}$。",
      "代入 $t=\\tan\\frac{x}{2}$ 即得。同理可得 $\\cos x$ 公式。"
    ],
    "intuition": "通过半角正切将三角函数的比值统一为有理分式，便于代数运算。",
    "common_tricks": [
      "遇到 $\\sin x\\pm\\cos x$ 或 $\\sin x\\cos x$ 型表达式时，可设 $t$ 化为有理方程。",
      "注意检查定义域，避免 $t$ 无定义或分母为零。",
      "用于解 $a\\sin x+b\\cos x=c$ 型方程时，化为关于 $t$ 的一元二次方程。"
    ]
  },
