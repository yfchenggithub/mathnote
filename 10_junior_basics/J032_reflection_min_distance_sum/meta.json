  "math": {
    "core_formula": "\\boxed{(PA+PB)_{\\min}=A'B}",
    "related_formulas": [
      "若$A,B$在$l$异侧，则$(PA+PB)_{\\min}=AB$"
    ],
    "variables": "点$A,B$为定点，直线$l$，动点$P\\in l$，$A'$为$A$关于$l$的对称点。",
    "conditions": "点$A,B$在直线$l$同侧，动点$P$在$l$上。",
    "conclusions": "$(PA+PB)_{\\min}=A'B$，当$P$为$A'B$与$l$交点时取等。"
  },
  "content": {
    "statement": "对于直线$l$同侧两定点$A,B$，动点$P$在$l$上。作$A$关于$l$的对称点$A'$，连接$A'B$交$l$于$P$，则$PA+PB$取得最小值，且最小值为$A'B$。",
    "derivation": [
      "作$A$关于$l$的对称点$A'$，则$PA=PA'$。",
      "连接$A'B$交$l$于$P$，则$PA+PB=PA'+PB$。",
      "由两点间线段最短得$PA'+PB\\ge A'B$，当$P$在$A'B$上时取等，即$(PA+PB)_{\\min}=A'B$。"
    ],
    "intuition": "利用对称性将折线拉直，转化为两点间线段最短。",
    "common_tricks": [
      "选择其中一个定点作关于直线的对称点（通常选较容易计算的）。",
      "若直线是坐标轴或特殊直线（如$y=x$），对称点坐标可直接写出。",
      "连接对称点与另一点，与直线的交点即为所求点$P$。",
      "若遇到多动点（如$P$在$l$上，$Q$在$m$上），可连续作对称转化为两定点间折线。"
    ]
  },
