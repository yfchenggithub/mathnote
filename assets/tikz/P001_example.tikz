\begin{tikzpicture}[scale=.75,>=stealth]
 \coordinate (O) at (0,0); \coordinate (P) at (5,0);
 \coordinate (A) at (50:3); \coordinate (C) at (3,0); \coordinate (B) at (-3,0);
 \draw[gray!60] (-3.5,0)--(5.5,0);
 \draw[teal!75!black,thick] (O) circle (3);
 \draw[teal!75!black] (O)--(A) node[midway,above left] {$R$};
 \draw[orange!85!black,thick] (P)--(A);
 \fill (O) circle (2pt) node[below] {$O$};
 \fill (P) circle (2pt) node[right] {$P$};
 \fill (A) circle (2pt) node[above] {$A$}; \path (O)--(P) node[midway,below] {$5$}; \fill (C) circle (2pt) node[below right] {$C$}; \fill (B) circle (2pt) node[left] {$B$};
 \end{tikzpicture}
